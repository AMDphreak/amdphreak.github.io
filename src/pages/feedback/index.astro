---
import { Footer } from "../../components/Footer";
import NoiseOverlay from "../../components/NoiseOverlay.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import ThemeToggleBar from "../../components/ThemeToggleBar.astro";
import { listFeedbackHubEntries } from "../../lib/feedback-hub";
import { tagIdToHref } from "@content-tags/core";
import "../../styles/tailwind.css";

const entries = listFeedbackHubEntries();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Feedback Hub filings - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <NoiseOverlay />
    <main class="w-full flex-1 mt-8 mb-12">
      <ThemeToggleBar container maxWidth="max-w-4xl" />
      <div class="container mx-auto px-6 py-12 max-w-4xl structural-border border-t-0 p-8 md:p-12 space-y-12">
        <nav
          class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4"
        >
          <div class="flex items-center gap-4">
            <a
              href="/"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Home</a
            >
            <a
              href="/blog"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Blog</a
            >
            <a
              href="/tags/microsoft/feedback-hub"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Tags</a
            >
          </div>
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-stone-300 dark:text-stone-700"
            >Feedback Hub</span
          >
        </nav>

        <header class="space-y-4 max-w-3xl">
          <h1 class="text-5xl font-heading tracking-tighter">Feedback Hub filings</h1>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">
            Clear-web mirror · no Microsoft owner API
          </p>
          <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed font-sans">
            Microsoft does not publish Feedback Hub posts as crawler-friendly pages, and there is no
            supported API to list or manage your own filings. This catalog is the source of truth on
            this site for items I choose to document. Hub share links still open the Windows app when
            available.
          </p>
        </header>

        {
          entries.length === 0 ? (
            <p class="text-sm text-stone-500">No filings recorded yet.</p>
          ) : (
            <ul class="space-y-8 m-0 p-0 list-none divide-y divide-stone-200 dark:divide-stone-800">
              {entries.map((entry) => (
                <li class="py-8 first:pt-0 space-y-3">
                  <h2 class="font-heading text-2xl tracking-tight">
                    {entry.blogPostId ? (
                      <a
                        href={`/blog/posts/${entry.blogPostId}`}
                        class="hover:underline decoration-stone-300 underline-offset-4"
                      >
                        {entry.title}
                      </a>
                    ) : (
                      entry.title
                    )}
                  </h2>
                  <p class="font-mono text-[10px] uppercase tracking-widest text-stone-400">
                    Submitted {entry.submittedAt}
                    {entry.hubStatus ? ` · Hub status: ${entry.hubStatus}` : ""}
                    {entry.sharePublicly ? " · shared publicly in Hub" : ""}
                  </p>
                  <div class="flex flex-wrap gap-4 font-mono text-[10px] uppercase tracking-[0.2em]">
                    {entry.shareUrl && (
                      <a
                        href={entry.shareUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
                      >
                        Hub share ↗
                      </a>
                    )}
                    {entry.blogPostId && (
                      <a
                        href={`/blog/posts/${entry.blogPostId}`}
                        class="text-stone-600 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100"
                      >
                        Blog post →
                      </a>
                    )}
                  </div>
                  {(entry.tags?.length ?? 0) > 0 && (
                    <ul class="flex flex-wrap gap-3 list-none m-0 p-0">
                      {entry.tags!.map((tagId) => (
                        <li>
                          <a
                            href={tagIdToHref(tagId)}
                            class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100"
                          >
                            {tagId}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {entry.notes && (
                    <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
                      {entry.notes}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

---
import { Footer } from "../components/Footer";
import { Photography } from "../components/Photography";
import { ProfileLinks } from "../components/ProfileLinks";
import SiteHeader from "../components/SiteHeader.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { heroProfileLinks, softwareProfileLinks } from "../lib/social-links";
import "../styles/tailwind.css";

const showHeroMark = false;

const navBtnBase =
  "inline-flex items-center justify-center gap-1.5 h-12 px-5 font-heading text-sm font-medium tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const navBtnPrimary = `${navBtnBase} structural-border bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-stone-200`;
/** Section links sit on the page background, including over a section wash. */
const navBtnSecondary = `${navBtnBase} structural-border bg-background text-foreground hover:bg-stone-100 dark:hover:bg-stone-900`;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <SiteIcons />
    <link rel="preload" as="image" href="/brand/ryan-runescape-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Ryan Johnson (AMDphreak) — central hub for products, organizations, and writing across the web."
    />
    <title>Ryan Johnson | AMDphreak</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800"
  >
    <div
      class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"
    >
    </div>

    <!-- Name and username. A little taller than the copy, not a full screen. -->
    <section
      class="relative z-10 flex w-full min-h-[24rem] flex-col overflow-hidden md:min-h-[28rem]"
      aria-label="Introduction"
    >
      <SiteHeader items={[{ label: "Home", href: "/" }]} />
      <div class="chrome-width hero-load flex flex-1 flex-col justify-end space-y-6 pt-8 lg:pt-10">
        <h1
          class="relative max-w-full whitespace-nowrap font-heading text-5xl font-light tracking-tight text-foreground max-[379px]:whitespace-normal sm:text-7xl md:text-8xl"
        >
          <span class="sr-only">Ryan Johnson</span><span class="hero-name" aria-hidden="true"><span class="hero-rune-slot"><img class="hero-rune" src="/brand/ryan-runescape-logo.svg" alt="" width="1647" height="1648" decoding="async" fetchpriority="high" draggable="false" /></span><span class="hero-cast"><span class="hero-under" aria-hidden="true"></span><span class="hero-letters">yan Johnson</span></span></span>
        </h1>
        <div class="hero-username flex items-center gap-3">
          {showHeroMark && <div class="blueprint-dot"></div>}
          <p
            class="hero-cast font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-400"
          >
            <span class="hero-handle-wash" aria-hidden="true"><span class="hero-handle-blur"><img class="hero-rune-blur" src="/brand/ryan-runescape-logo.svg" alt="" width="1647" height="1648" decoding="async" draggable="false" /></span></span><span class="hero-letters">AMDphreak</span>
          </p>
        </div>
        <ProfileLinks client:load links={heroProfileLinks} label="Other profiles" falloff />
      </div>
    </section>

    <main class="py-12 lg:py-16">
      <section aria-label="Software" class="home-software text-foreground">
        <div class="chrome-width space-y-6 py-12 lg:py-16">
          <h2 class="font-heading text-3xl tracking-tighter text-foreground">
            Software
          </h2>
          <p class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-300">
            Architecture, Systems, UX
          </p>
          <p class="home-copy leading-relaxed">
            Software and systems, built carefully. UX, DevX, ITIL, Architecture, RelyOps, DevOps. More than a software developer: a visionary.
          </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/repositories" class={navBtnPrimary}>
            Catalog
            <span class="font-mono text-[11px] opacity-60" aria-hidden="true">→</span>
          </a>
          <a href="/resume" class={navBtnSecondary}>
            Résumé
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/philosophy" class={navBtnSecondary}>
            Philosophy
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/background" class={navBtnSecondary}>
            Background
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/inspirations" class={navBtnSecondary}>
            Inspirations
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/for-fun" class={navBtnSecondary}>
            For fun 🥳
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/blog" class={navBtnSecondary}>
            Blog
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
        </div>
        <ProfileLinks client:load links={softwareProfileLinks} label="Code profiles" />
        </div>
      </section>

      <div class="home-photography text-foreground">
        <div class="chrome-width py-12 lg:py-16">
          <Photography client:load collapsible={false} />
        </div>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
<style>
  @property --hero-em {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }
  @property --handle-em {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }
  :global(html) {
    --hero-near: white;
  }
  :global(html.dark) {
    --hero-near: black;
  }
  /* Same steps as the heading: text-5xl, sm:text-7xl, md:text-8xl. */
  .hero-load {
    --hero-em: 3rem;
  }
  @media (min-width: 40rem) {
    .hero-load {
      --hero-em: 4.5rem;
    }
  }
  @media (min-width: 48rem) {
    .hero-load {
      --hero-em: 6rem;
    }
  }
  .hero-load > h1,
  .hero-load > div {
    position: relative;
    z-index: 1;
  }
  /* Socials paint above the username wash, so the blur does not cover them. */
  .hero-load :global(ul[aria-label="Other profiles"]) {
    position: relative;
    z-index: 2;
  }
  /* The username sits on the lower curve of the stone. */
  .hero-username {
    margin-top: -0.45rem;
  }
  .hero-name {
    position: relative;
    z-index: 1;
  }
  .hero-rune-slot {
    position: relative;
    display: inline-block;
    width: 0.82em;
    height: 0.71em;
    vertical-align: baseline;
  }
  .hero-rune {
    position: absolute;
    z-index: -1;
    height: 2.15em;
    width: auto;
    max-width: none;
    left: calc(-0.35em - 20px);
    bottom: calc(-0.58em - 15px);
    pointer-events: none;
    user-select: none;
    /* One light monochrome on both themes. The SVG file stays full color. */
    filter: grayscale(1) contrast(1.12) brightness(2.05);
  }
  /* Same layer as .hero-letters. The link itself stays auto so the wash can sit behind it. */
  :global(.hero-ink) {
    position: relative;
    z-index: 1;
    color: inherit;
  }
  /* Soft separation under the strings the stone underlaps. The blur is on the wash, not the letters. */
  .hero-cast {
    position: relative;
    display: inline-block;
  }
  .hero-name .hero-cast {
    margin-left: 10px;
  }
  .hero-letters {
    position: relative;
    z-index: 1;
  }
  /* Name only. The simpler shadow from before the shared ellipse. */
  .hero-under {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      var(--hero-near),
      transparent 82%
    );
    filter: blur(10px);
  }
  .hero-name .hero-under {
    left: -26px;
    top: 0;
    width: 9.25rem;
    height: 108%;
  }
  /* Username only. Centered on this box, not on the name shadow. */
  .hero-handle-wash {
    --handle-em: 1em;
    --handle-ellipse: radial-gradient(
      ellipse farthest-side at 50% 50%,
      rgb(0 0 0 / 50%) 0%,
      transparent 100%
    );
    position: absolute;
    z-index: 0;
    pointer-events: none;
    left: -28px;
    top: calc(50% - 2.1em);
    width: calc(100% + 56px);
    height: 4.2em;
  }
  /* The stone copy is masked to that same ellipse. The color wash paints above it. */
  .hero-handle-blur {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mask-image: radial-gradient(
      ellipse farthest-side at 50% 50%,
      black 0%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse farthest-side at 50% 50%,
      black 0%,
      transparent 100%
    );
    mask-mode: alpha;
    -webkit-mask-mode: alpha;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-position: center;
    -webkit-mask-position: center;
  }
  .hero-handle-wash::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: var(--handle-ellipse);
  }
  /* Same box as the sharp rune. The mask on .hero-handle-blur keeps the blur in this ellipse.
     Horizontal: rune left (-0.35em - 20px) minus the wash left (-28px).
     Vertical: rune top against the heading baseline, minus the username gap (1.5rem - 0.45rem) and half the username line. */
  .hero-rune-blur {
    position: absolute;
    left: calc(-0.35 * var(--hero-em) + 8px);
    top: calc(-1.72625 * var(--hero-em) + 2.1 * var(--handle-em) + 15px - 1.675rem);
    height: calc(2.15 * var(--hero-em));
    width: auto;
    max-width: none;
    pointer-events: none;
    user-select: none;
    filter: grayscale(1) contrast(1.12) brightness(2.05) blur(22px);
  }
</style>

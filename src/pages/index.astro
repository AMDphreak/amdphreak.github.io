---
import Breadcrumb from "../components/Breadcrumb.astro";
import { Footer } from "../components/Footer";
import { Photography } from "../components/Photography";
import { ProfileLinks } from "../components/ProfileLinks";
import NoiseOverlay from "../components/NoiseOverlay.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/tailwind.css";

const navBtnBase =
  "inline-flex items-center justify-center gap-1.5 h-12 px-5 font-heading text-sm font-medium tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const navBtnPrimary = `${navBtnBase} structural-border bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-stone-200`;
/** Section links sit on the page, not the frosted tapestry. */
const navBtnSecondary = `${navBtnBase} structural-border bg-background text-foreground hover:bg-stone-100 dark:hover:bg-stone-900`;

/** Hero tapestry tiers (Lanczos): 1280 / 1920 / 2560.
 * Display width is rem (not vw) so browser zoom scales it with page content.
 * 120rem ≈ 1920px — covers typical desktops with ~10% past each edge of a ~1600px viewport. */
const heroTapestrySrcset =
  "/hero/rainbow-crystal-tapestry-1280.webp 1280w, /hero/rainbow-crystal-tapestry-1920.webp 1920w, /hero/rainbow-crystal-tapestry-2560.webp 2560w";
const heroTapestrySizes = "120rem";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Ryan Johnson (AMDphreak) — central hub for products, organizations, and writing across the web."
    />
    <title>Ryan Johnson | AMDphreak</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800"
  >
    <NoiseOverlay />
    <div
      class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"
    >
    </div>

    <!-- Name and username over the tapestry. Short enough that Software peeks in on a desktop. -->
    <section
      class="relative z-10 w-full overflow-hidden"
      aria-label="Introduction"
    >
      <!-- rem width (not vw): zooms with content; ~10% past edges of a typical desktop at 100% -->
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 w-[120rem] max-w-none -translate-x-1/2 -translate-y-1/2"
        aria-hidden="true"
      >
        <img
          class="hero-tapestry block h-auto w-full max-w-none"
          src="/hero/rainbow-crystal-tapestry-1920.webp"
          srcset={heroTapestrySrcset}
          sizes={heroTapestrySizes}
          width={1920}
          height={800}
          alt="Rainbow crystal tapestry — three frames of prism light and orchids at a bright window"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <!-- Light global scrims; localized readability comes from hero-content-frost -->
      <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
        <!-- Gentle R→L lift on the right — blur panel handles social column -->
        <div
          class="absolute inset-0 bg-gradient-to-l from-background/55 from-0% via-background/28 via-28% to-transparent to-62% dark:from-background/60 dark:via-background/32 dark:via-26% dark:to-transparent dark:to-58%"
        >
        </div>
        <!-- Soft left band for name column -->
        <div
          class="absolute inset-y-0 left-0 w-[min(100%,52rem)] bg-gradient-to-r from-background/62 via-background/32 to-transparent dark:from-background/68 dark:via-background/36"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-background via-background/35 to-background/55 dark:from-background dark:via-background/42 dark:to-background/65"
        >
        </div>
        <!-- Top-right corner: subtle blend where tapestry meets page bg -->
        <div
          class="absolute inset-0 bg-gradient-to-bl from-background/85 from-16% via-background/25 via-38% to-transparent dark:from-background dark:from-18% dark:via-background/32 dark:via-40%"
        >
        </div>
      </div>

      <div
        class="relative z-10 mx-auto flex w-full max-w-7xl flex-col px-6 pt-8 pb-8 lg:pt-10 lg:pb-10"
      >
        <header
          class="flex flex-wrap items-center justify-between gap-6 border-b border-stone-200/80 pb-6 dark:border-stone-800/80"
        >
          <Breadcrumb class="border-0 pb-0" items={[{ label: "Home", href: "/" }]} />
          <ThemeToggle />
        </header>

        <div class="relative isolate pt-8 lg:pt-10">
          <div
            class="hero-content-frost absolute -inset-x-8 -inset-y-4 sm:-inset-x-10 lg:-inset-x-16"
            aria-hidden="true"
          >
          </div>

          <div class="relative z-10 max-w-3xl min-w-0 space-y-6 pointer-events-auto">
            <h1
              class="font-heading text-6xl font-light tracking-tight text-foreground md:text-8xl"
            >
              Ryan<br />Johnson
            </h1>
            <div class="flex items-center gap-3">
              <div class="blueprint-dot"></div>
              <p
                class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-400"
              >
                AMDphreak
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <main class="relative z-10 container mx-auto max-w-7xl space-y-20 px-6 py-12 lg:space-y-28">
      <section aria-label="Software" class="space-y-6">
        <h2 class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-700 dark:text-stone-400">
          Software
        </h2>
        <p class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-400">
          Software Architect
        </p>
        <p class="max-w-2xl font-sans text-lg leading-relaxed text-stone-700 dark:text-stone-300 md:text-xl">
          Software and systems, built carefully — UX, DevX, ITIL, Architecture, RelyOps, DevOps. More than a software developer: a visionary.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/repositories" class={navBtnPrimary}>
            Catalog
            <span class="font-mono text-[10px] opacity-60" aria-hidden="true">→</span>
          </a>
          <a href="/resume" class={navBtnSecondary}>
            Résumé
            <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/philosophy" class={navBtnSecondary}>
            Philosophy
            <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a
            href="/gui-demos"
            class={navBtnSecondary}
            aria-label="UI/UX — philosophy and interactive demos"
          >
            UI/UX
            <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/inspirations" class={navBtnSecondary}>
            Inspirations
            <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/for-fun" class={navBtnSecondary}>
            For fun
            <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/blog" class={navBtnSecondary}>
            Blog
            <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
          </a>
        </div>
      </section>

      <section aria-label="Profiles" class="space-y-4">
        <h2 class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-700 dark:text-stone-400">
          Profiles
        </h2>
        <ProfileLinks client:load />
      </section>

      <Photography client:load collapsible={false} />
    </main>

    <Footer client:load />
  </body>
</html>

---
import { Profile } from "../components/Profile";
import { About } from "../components/About";
import { Experience } from "../components/Experience";
import { Projects } from "../components/Projects";
import { Skills } from "../components/Skills";
import { Photography } from "../components/Photography";
import { Footer } from "../components/Footer";
import NoiseOverlay from "../components/NoiseOverlay.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/tailwind.css";

const navBtnBase =
  "inline-flex items-center justify-center gap-1.5 h-8 px-4 structural-border font-heading text-sm font-medium tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const navBtnInternal = `${navBtnBase} text-stone-900 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-900`;
const navBtnExternal = `${navBtnBase} bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-stone-200`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <title>Ryan Johnson | Technical Overview</title>
    
    <ThemeScript />
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800">
    <NoiseOverlay />
    <div class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"></div>
    
    <main class="relative z-10 container mx-auto px-6 py-12 max-w-7xl space-y-16 lg:space-y-24">
      <!-- Structural Top Header -->
      <header class="flex flex-wrap justify-between items-center gap-6 border-b border-stone-200 dark:border-stone-800 pb-8">
        <div class="flex flex-wrap items-center gap-6 lg:gap-10">
          <h1 class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500">Technical Overview / 2026</h1>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="/gui-demos"
              class={navBtnInternal}
              aria-label="UI/UX — philosophy and interactive demos"
            >
              UI/UX
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
            <a
              href="/inspirations"
              class={navBtnInternal}
            >
              Inspirations
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
            <a
              href="https://www.ryanjohnson.website/posts"
              target="_blank"
              rel="noopener noreferrer"
              class={navBtnExternal}
            >
              Personal Blog
              <span class="font-mono text-[10px] opacity-60" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <ThemeToggle />
        </div>
      </header>

      <div id="profile-section" class="border-b border-stone-200 dark:border-stone-800 pb-16">
        <Profile client:load />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <!-- Main Column -->
        <div class="lg:col-span-8 space-y-16 lg:space-y-24">
          <About client:load />

          <section id="projects-section" class="scroll-mt-20">
            <Projects client:load />
          </section>

          <Experience client:load />

          <Photography client:load />
        </div>

        <!-- Sidebar / Structural Support -->
        <aside class="lg:col-span-4 space-y-16 lg:border-l lg:border-stone-200 dark:lg:border-stone-800 lg:pl-12">
          <section id="skills-section" class="scroll-mt-20">
            <Skills client:load />
          </section>
        </aside>
      </div>
    </main>

    <Footer client:load />

  </body>
</html>

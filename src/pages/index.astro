---
import { Footer } from "../components/Footer";
import { Photography } from "../components/Photography";
import { HeroSocialLinks } from "../components/HeroSocialLinks";
import NoiseOverlay from "../components/NoiseOverlay.astro";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { hubSections } from "../lib/hub-destinations";
import "../styles/tailwind.css";

const navBtnBase =
  "inline-flex items-center justify-center gap-1.5 h-12 px-5 structural-border font-heading text-sm font-medium tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const navBtnInternal = `${navBtnBase} text-stone-900 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-900`;
const navBtnPrimary = `${navBtnBase} bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-stone-200`;
const navBtnGhost = `${navBtnBase} text-stone-900 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-900`;

const productsSection = hubSections.find((s) => s.id === "products")!;
const codeSection = hubSections.find((s) => s.id === "code")!;
const showcaseDestinations = productsSection.destinations.filter((d) => d.screenshot);

const productScreenshotSizes =
  "(max-width: 639px) min(22rem, 90vw), (max-width: 1023px) min(22rem, 45vw), (max-width: 1279px) min(22rem, 30vw), 24rem";

function productScreenshotSrcset(id: string) {
  return `/products/${id}-400.webp 400w, /products/${id}-800.webp 800w`;
}

/** Full-bleed hero tapestry tiers (Lanczos): 1280 / 1920 / 2560 */
const heroTapestrySrcset =
  "/hero/rainbow-crystal-tapestry-1280.webp 1280w, /hero/rainbow-crystal-tapestry-1920.webp 1920w, /hero/rainbow-crystal-tapestry-2560.webp 2560w";
const heroTapestrySizes = "100vw";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Ryan Johnson (AMDphreak) — central hub for products, organizations, and writing across the web."
    />
    <title>Ryan Johnson | AMDphreak</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800"
  >
    <NoiseOverlay />
    <div
      class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"
    >
    </div>

    <!-- Full-bleed brand-first hero: tall viewport + vertically centered full-width tapestry -->
    <section
      class="relative z-10 min-h-[100svh] w-full overflow-hidden"
      aria-label="Introduction"
    >
      <div
        class="pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2"
        aria-hidden="true"
      >
        <img
          class="hero-tapestry block w-full max-w-full h-auto"
          src="/hero/rainbow-crystal-tapestry-1920.webp"
          srcset={heroTapestrySrcset}
          sizes={heroTapestrySizes}
          width={1920}
          height={800}
          alt="Rainbow crystal tapestry — three frames of prism light and orchids at a bright window"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <!-- Readable text plane: theme-aware scrims over the full hero -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute inset-0 bg-gradient-to-l from-background/50 from-22% via-background/85 via-55% to-background to-85% dark:from-background/55 dark:from-24% dark:via-background/90 dark:via-50% dark:to-background dark:to-80%"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-background/65 dark:from-background dark:via-background/50 dark:to-background/72"
        >
        </div>
        <!-- Top-right corner: supplements light R→L scrim where photo bg meets page bg -->
        <div
          class="absolute inset-0 bg-gradient-to-bl from-background/55 from-28% via-transparent to-transparent dark:from-background/65 dark:from-32%"
        >
        </div>
      </div>

      <div
        class="relative z-10 mx-auto flex min-h-[100svh] w-full max-w-7xl flex-col px-6 py-12 lg:py-16"
      >
        <header
          class="flex flex-wrap items-center justify-between gap-6 border-b border-stone-200/80 pb-8 dark:border-stone-800/80"
        >
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500">
            Home / 2026
          </p>
          <ThemeToggle />
        </header>

        <div class="flex flex-1 flex-col justify-center gap-10 py-10 lg:py-16">
          <div
            class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16"
          >
            <div class="max-w-3xl min-w-0 flex-1 space-y-6">
              <h1
                class="font-heading text-6xl font-light tracking-tight text-foreground md:text-8xl"
              >
                Ryan<br />Johnson
              </h1>
              <div class="flex items-center gap-3">
                <div class="blueprint-dot"></div>
                <p
                  class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-400"
                >
                  AMDphreak / Software Architect
                </p>
              </div>
              <p
                class="max-w-2xl font-sans text-lg leading-relaxed text-stone-700 dark:text-stone-300 md:text-xl"
              >
                Software and systems, built carefully — UX, DevX, ITIL, Architecture. More than a software developer: a visionary.
              </p>
            </div>

            <div class="shrink-0 lg:self-center lg:pt-3">
              <HeroSocialLinks client:load />
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <a href="#products" class={navBtnPrimary}>
              Browse work
              <span class="font-mono text-[10px] opacity-60" aria-hidden="true">↓</span>
            </a>
            <a href="/resume" class={navBtnGhost}>
              Résumé
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
            <a href="/philosophy" class={navBtnGhost}>
              Philosophy
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
            <a
              href="/gui-demos"
              class={navBtnInternal}
              aria-label="UI/UX — philosophy and interactive demos"
            >
              UI/UX
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
            <a href="/inspirations" class={navBtnInternal}>
              Inspirations
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
            <a href="/blog" class={navBtnGhost}>
              Blog
              <span class="font-mono text-[10px] opacity-70" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <main class="relative z-10 container mx-auto max-w-7xl space-y-20 px-6 py-12 lg:space-y-28">
      <section id="products" class="scroll-mt-24 space-y-8">
        <div class="flex items-end gap-4 border-b border-stone-200 dark:border-stone-800 pb-4">
          <h2 class="text-3xl font-heading tracking-tighter">{productsSection.title}</h2>
          <span class="font-mono text-[10px] uppercase tracking-widest text-stone-500 mb-1">
            {productsSection.tagline}
          </span>
        </div>

        <div class="w-[90%] mx-auto flex flex-wrap justify-center gap-8 lg:gap-10">
          {
            showcaseDestinations.map((dest) => (
              <article class="product-showcase-card group w-full max-w-[22rem] sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.75rem)] xl:max-w-[24rem] xl:w-[calc(25%-1.9rem)] flex-none rounded-[2rem] bg-stone-100/80 dark:bg-stone-900/60 p-3 sm:p-3.5 pb-5 shadow-sm ring-1 ring-stone-200/80 dark:ring-stone-800/80">
                <div class="relative">
                  <div class="overflow-hidden rounded-[1.35rem] bg-stone-200 dark:bg-stone-950 aspect-[4/3]">
                    <img
                      src={dest.screenshot!}
                      srcset={productScreenshotSrcset(dest.id)}
                      sizes={productScreenshotSizes}
                      alt={`Screenshot of ${dest.name}`}
                      width={800}
                      height={600}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-top origin-top transition-transform duration-700 ease-out will-change-transform group-hover:scale-[1.03]"
                    />
                  </div>
                  {/* Fade begins ~45% down the shot; content continues through the lower card */}
                  <div class="relative -mt-[55%] flex min-h-[55%] flex-col justify-end gap-3 rounded-b-[1.35rem] px-5 pb-1 pt-16 bg-gradient-to-t from-background from-35% via-background/95 via-55% to-transparent">
                    <a
                      href={dest.href}
                      target={dest.external ? "_blank" : undefined}
                      rel={dest.external ? "noopener noreferrer" : undefined}
                      class="group/title inline-flex items-baseline gap-2 no-underline"
                    >
                      <h3 class="text-xl font-heading font-medium tracking-tight text-foreground group-hover/title:underline decoration-stone-300 underline-offset-4">
                        {dest.name}
                      </h3>
                      {dest.external && (
                        <span
                          class="font-mono text-[10px] text-stone-400 opacity-70"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      )}
                    </a>
                    <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
                      {dest.tagline}
                    </p>
                    <div class="flex flex-wrap gap-4 pt-1">
                      <a
                        href={dest.href}
                        target={dest.external ? "_blank" : undefined}
                        rel={dest.external ? "noopener noreferrer" : undefined}
                        class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
                      >
                        {dest.external ? "Visit" : "Open"} →
                      </a>
                      {dest.secondaryHref && (
                        <a
                          href={dest.secondaryHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
                        >
                          {dest.secondaryLabel ?? "More"} ↗
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id={codeSection.id} class="scroll-mt-24 space-y-8">
        <div class="flex items-end gap-4 border-b border-stone-200 dark:border-stone-800 pb-4">
          <h2 class="text-3xl font-heading tracking-tighter">{codeSection.title}</h2>
          <span class="font-mono text-[10px] uppercase tracking-widest text-stone-500 mb-1">
            {codeSection.tagline}
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-stone-200 dark:bg-stone-800 border border-stone-200 dark:border-stone-800">
          {
            codeSection.destinations.map((dest) => (
              <div class="bg-background p-6 flex flex-col gap-4 min-h-[160px]">
                <div class="space-y-2 flex-1">
                  <a
                    href={dest.href}
                    target={dest.external ? "_blank" : undefined}
                    rel={dest.external ? "noopener noreferrer" : undefined}
                    class="group inline-flex items-baseline gap-2 no-underline"
                  >
                    <h3 class="text-xl font-heading font-medium tracking-tight text-foreground group-hover:underline decoration-stone-300 underline-offset-4">
                      {dest.name}
                    </h3>
                    {dest.external && (
                      <span
                        class="font-mono text-[10px] text-stone-400 opacity-70"
                        aria-hidden="true"
                      >
                        ↗
                      </span>
                    )}
                  </a>
                  <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
                    {dest.tagline}
                  </p>
                </div>
                <div class="flex flex-wrap gap-4">
                  <a
                    href={dest.href}
                    target={dest.external ? "_blank" : undefined}
                    rel={dest.external ? "noopener noreferrer" : undefined}
                    class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
                  >
                    {dest.external ? "Visit" : "Open"} →
                  </a>
                  {dest.secondaryHref && (
                    <a
                      href={dest.secondaryHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
                    >
                      {dest.secondaryLabel ?? "More"} ↗
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <Photography client:load collapsible={false} />
    </main>

    <Footer client:load />
  </body>
</html>

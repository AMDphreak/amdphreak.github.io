---
import { Footer } from "../components/Footer";
import { Photography } from "../components/Photography";
import { ProfileLinks } from "../components/ProfileLinks";
import SiteHeader from "../components/SiteHeader.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { heroProfileLinks, softwareProfileLinks } from "../lib/social-links";
import "../styles/tailwind.css";

const showHeroMark = false;

const navBtnBase =
  "inline-flex items-center justify-center gap-1.5 h-12 px-5 font-heading text-sm font-medium tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const navBtnPrimary = `${navBtnBase} structural-border bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-stone-200`;
/** Section links sit on the page background, including over a section wash. */
const navBtnSecondary = `${navBtnBase} structural-border bg-background text-foreground hover:bg-stone-100 dark:hover:bg-stone-900`;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <SiteIcons />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Ryan Johnson (AMDphreak) — central hub for products, organizations, and writing across the web."
    />
    <title>Ryan Johnson | AMDphreak</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800"
  >
    <div
      class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"
    >
    </div>

    <!-- Name and username. A little taller than the copy, not a full screen. -->
    <section
      class="relative z-10 flex w-full min-h-[24rem] flex-col md:min-h-[28rem]"
      aria-label="Introduction"
    >
      <SiteHeader items={[{ label: "Home", href: "/" }]} />
      <div class="chrome-width flex flex-1 flex-col justify-end space-y-6 pt-8 lg:pt-10">
        <h1
          class="max-w-full whitespace-nowrap font-heading text-5xl font-light tracking-tight text-foreground max-[379px]:whitespace-normal sm:text-7xl md:text-8xl"
        >
          Ryan <span class="hero-johnson"><span class="hero-johnson-text">Johnson<svg class="hero-johnson-field" aria-hidden="true" focusable="false"><defs><filter id="johnson-falloff-blur" x="-50%" y="-80%" width="200%" height="260%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="10" /></filter><radialGradient id="johnson-falloff" cx="50%" cy="50%" r="52%"><stop offset="0%" style="stop-color: var(--johnson-near)" /><stop offset="100%" style="stop-color: var(--johnson-near); stop-opacity: 0" /></radialGradient></defs><rect width="100%" height="100%" fill="url(#johnson-falloff)" filter="url(#johnson-falloff-blur)" /></svg></span><img class="hero-rune hero-rune-sharp hero-rune-light" src="/brand/ryan-runescape-logo.svg" alt="" aria-hidden="true" /><img class="hero-rune hero-rune-blur hero-rune-light" src="/brand/ryan-runescape-logo.svg" alt="" aria-hidden="true" /><img class="hero-rune hero-rune-sharp hero-rune-dark" src="/brand/ryan-runescape-logo.svg" alt="" aria-hidden="true" /><img class="hero-rune hero-rune-blur hero-rune-dark" src="/brand/ryan-runescape-logo.svg" alt="" aria-hidden="true" /></span>
        </h1>
        <div class="flex items-center gap-3">
          {showHeroMark && <div class="blueprint-dot"></div>}
          <p
            class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-400"
          >
            AMDphreak
          </p>
        </div>
        <ProfileLinks client:load links={heroProfileLinks} label="Other profiles" />
      </div>
    </section>

    <main class="py-12 lg:py-16">
      <section aria-label="Software" class="home-software text-foreground">
        <div class="chrome-width space-y-6 py-12 lg:py-16">
          <h2 class="font-heading text-3xl tracking-tighter text-foreground">
            Software
          </h2>
          <p class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-300">
            Architecture, Systems, UX
          </p>
          <p class="home-copy leading-relaxed">
            Software and systems, built carefully. UX, DevX, ITIL, Architecture, RelyOps, DevOps. More than a software developer: a visionary.
          </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/repositories" class={navBtnPrimary}>
            Catalog
            <span class="font-mono text-[11px] opacity-60" aria-hidden="true">→</span>
          </a>
          <a href="/resume" class={navBtnSecondary}>
            Résumé
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/philosophy" class={navBtnSecondary}>
            Philosophy
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/background" class={navBtnSecondary}>
            Background
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/inspirations" class={navBtnSecondary}>
            Inspirations
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/for-fun" class={navBtnSecondary}>
            For fun 🥳
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/blog" class={navBtnSecondary}>
            Blog
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
        </div>
        <ProfileLinks client:load links={softwareProfileLinks} label="Code profiles" />
        </div>
      </section>

      <div class="home-photography text-foreground">
        <div class="chrome-width py-12 lg:py-16">
          <Photography client:load collapsible={false} />
        </div>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>
<style>
  .hero-johnson {
    --rune-x: 50%;
    --rune-y: 50%;
    --johnson-near: black;
    position: relative;
    display: inline-block;
    vertical-align: baseline;
  }
  :global(html.dark) .hero-johnson {
    --johnson-near: white;
  }
  .hero-johnson-text {
    position: relative;
    z-index: 1;
    color: var(--color-foreground);
    -webkit-mask-image: linear-gradient(#000, #000);
    mask-image: linear-gradient(#000, #000);
    -webkit-mask-clip: text;
    mask-clip: text;
  }
  .hero-johnson-field {
    position: absolute;
    left: var(--rune-x);
    top: var(--rune-y);
    width: 2.6em;
    height: 2.2em;
    transform: translate(-50%, -50%);
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }
  .hero-rune {
    position: absolute;
    left: var(--rune-x);
    top: var(--rune-y);
    height: 1.85em;
    width: auto;
    transform: translate(-50%, -50%);
    pointer-events: none;
    user-select: none;
  }
  .hero-rune-dark {
    display: none;
  }
  :global(html.dark) .hero-rune-light {
    display: none;
  }
  :global(html.dark) .hero-rune-dark {
    display: block;
  }
  .hero-rune-sharp {
    z-index: 0;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 14%,
      transparent 40%,
      transparent 60%,
      #000 86%,
      #000 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 14%,
      transparent 40%,
      transparent 60%,
      #000 86%,
      #000 100%
    );
  }
  .hero-rune-blur {
    z-index: 0;
    opacity: 0.32;
    filter: blur(8px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 8%, #000 42%, #000 58%, transparent 92%);
    mask-image: linear-gradient(to bottom, transparent 8%, #000 42%, #000 58%, transparent 92%);
  }
  :global(html.dark) .hero-rune-sharp {
    opacity: 0.72;
  }
  :global(html.dark) .hero-rune-blur {
    opacity: 0.42;
  }
</style>

---
import { Footer } from "../components/Footer";
import { Photography } from "../components/Photography";
import { ProfileLinks } from "../components/ProfileLinks";
import SiteHeader from "../components/SiteHeader.astro";
import SiteIcons from "../components/SiteIcons.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { heroProfileLinks, softwareProfileLinks } from "../lib/social-links";
import "../styles/tailwind.css";

const showHeroMark = false;

const navBtnBase =
  "inline-flex items-center justify-center gap-1.5 h-12 px-5 font-heading text-sm font-medium tracking-tight transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 focus-visible:ring-offset-2 focus-visible:ring-offset-background";
const navBtnPrimary = `${navBtnBase} structural-border bg-stone-900 text-stone-50 dark:bg-stone-100 dark:text-stone-900 hover:bg-stone-800 dark:hover:bg-stone-200`;
/** Section links sit on the page background, including over a section wash. */
const navBtnSecondary = `${navBtnBase} structural-border bg-background text-foreground hover:bg-stone-100 dark:hover:bg-stone-900`;

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <SiteIcons />
    <link rel="preload" as="image" href="/brand/ryan-runescape-logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Ryan Johnson (AMDphreak) — central hub for products, organizations, and writing across the web."
    />
    <title>Ryan Johnson | AMDphreak</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800"
  >
    <div
      class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"
    >
    </div>

    <!-- Name and username. A little taller than the copy, not a full screen. -->
    <section
      class="relative z-10 flex w-full min-h-[24rem] flex-col overflow-hidden md:min-h-[28rem]"
      aria-label="Introduction"
    >
      <SiteHeader items={[{ label: "Home", href: "/" }]} />
      <div class="chrome-width hero-load flex flex-1 flex-col justify-end space-y-6 pt-8 lg:pt-10">
        <svg class="hero-falloff-defs" aria-hidden="true" focusable="false" width="0" height="0">
          <defs>
            <filter id="hero-falloff-blur" x="-40%" y="-40%" width="180%" height="180%" color-interpolation-filters="sRGB">
              <feGaussianBlur stdDeviation="10" />
            </filter>
            <radialGradient id="hero-falloff" cx="50%" cy="50%" r="50%">
              <stop offset="0%" style="stop-color: var(--hero-near)" />
              <stop offset="100%" style="stop-color: var(--hero-near); stop-opacity: 0" />
            </radialGradient>
          </defs>
        </svg>
        <h1
          class="relative max-w-full whitespace-nowrap font-heading text-5xl font-light tracking-tight text-foreground max-[379px]:whitespace-normal sm:text-7xl md:text-8xl"
        >
          <span class="sr-only">Ryan Johnson</span><span class="hero-name" aria-hidden="true"><span class="hero-rune-slot"><img class="hero-rune" src="/brand/ryan-runescape-logo.svg" alt="" width="220" height="266" decoding="async" fetchpriority="high" draggable="false" /></span><span class="hero-ink">yan Johnson<svg class="hero-field" aria-hidden="true" focusable="false"><rect width="100%" height="100%" fill="url(#hero-falloff)" filter="url(#hero-falloff-blur)" /></svg></span></span>
        </h1>
        <div class="hero-username flex items-center gap-3">
          {showHeroMark && <div class="blueprint-dot"></div>}
          <p
            class="hero-ink font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-400"
          >
            AMDphreak<svg class="hero-field" aria-hidden="true" focusable="false"><rect width="100%" height="100%" fill="url(#hero-falloff)" filter="url(#hero-falloff-blur)" /></svg>
          </p>
        </div>
        <ProfileLinks client:load links={heroProfileLinks} label="Other profiles" falloff />
      </div>
    </section>

    <main class="pt-12 lg:pt-16">
      <section aria-label="Software" class="home-software text-foreground">
        <div class="chrome-width space-y-6 py-12 lg:py-16">
          <h2 class="font-heading text-3xl tracking-tighter text-foreground">
            Software
          </h2>
          <p class="font-mono text-sm uppercase tracking-[0.3em] text-stone-600 dark:text-stone-300">
            Architecture, Systems, UX
          </p>
          <p class="home-copy leading-relaxed">
            Software and systems, built carefully. UX, DevX, ITIL, Architecture, RelyOps, DevOps. More than a software developer: a visionary.
          </p>
        <div class="flex flex-wrap items-center gap-3">
          <a href="/repositories" class={navBtnPrimary}>
            Catalog
            <span class="font-mono text-[11px] opacity-60" aria-hidden="true">→</span>
          </a>
          <a href="/resume" class={navBtnSecondary}>
            Résumé
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/philosophy" class={navBtnSecondary}>
            Philosophy
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/background" class={navBtnSecondary}>
            Background
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/inspirations" class={navBtnSecondary}>
            Inspirations
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/for-fun" class={navBtnSecondary}>
            For fun 🥳
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
          <a href="/blog" class={navBtnSecondary}>
            Blog
            <span class="font-mono text-[11px] opacity-70" aria-hidden="true">→</span>
          </a>
        </div>
        <ProfileLinks client:load links={softwareProfileLinks} label="Code profiles" />
        </div>
      </section>

      <div class="home-photography text-foreground">
        <div class="chrome-width py-12 lg:py-16">
          <Photography client:load collapsible={false} />
        </div>
      </div>
      <section class="home-gap" aria-hidden="true"></section>
    </main>

    <Footer client:load />
  </body>
</html>
<style>
  :global(html) {
    --hero-near: black;
  }
  :global(html.dark) {
    --hero-near: white;
  }
  .hero-falloff-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .hero-load > h1,
  .hero-load > div {
    position: relative;
    z-index: 1;
  }
  /* The username sits on the lower curve of the stone. */
  .hero-username {
    margin-top: -0.45rem;
  }
  .hero-name {
    position: relative;
    z-index: 1;
  }
  .hero-rune-slot {
    position: relative;
    display: inline-block;
    width: 0.82em;
    height: 0.71em;
    vertical-align: baseline;
  }
  .hero-rune {
    anchor-name: --hero-rune;
    position: absolute;
    z-index: -1;
    height: 2.15em;
    width: auto;
    max-width: none;
    left: -0.35em;
    bottom: -0.58em;
    pointer-events: none;
    user-select: none;
  }
  :global(.hero-ink) {
    position: relative;
    color: inherit;
    -webkit-mask-image: linear-gradient(#000, #000);
    mask-image: linear-gradient(#000, #000);
    -webkit-mask-clip: text;
    mask-clip: text;
  }
  :global(.hero-field) {
    position: absolute;
    position-anchor: --hero-rune;
    left: anchor(center);
    top: anchor(center);
    translate: -50% -50%;
    width: 34rem;
    height: 22rem;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }
</style>

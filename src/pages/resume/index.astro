---
import { Profile } from "../../components/Profile";
import { Experience } from "../../components/Experience";
import { Projects } from "../../components/Projects";
import { Skills } from "../../components/Skills";
import { Footer } from "../../components/Footer";
import NoiseOverlay from "../../components/NoiseOverlay.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import "../../styles/tailwind.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <title>Ryan Johnson | Résumé</title>
    
    <ThemeScript />
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans antialiased selection:bg-stone-200 dark:selection:bg-stone-800">
    <NoiseOverlay />
    <div class="fixed inset-0 pointer-events-none border-[12px] border-stone-100/50 dark:border-stone-900/50 z-[100]"></div>
    
    <main class="relative z-10 container mx-auto px-6 py-12 max-w-7xl space-y-16 lg:space-y-24">
      <!-- Structural Top Header -->
      <header class="flex flex-wrap justify-between items-center gap-6 border-b border-stone-200 dark:border-stone-800 pb-8">
        <div class="flex flex-wrap items-center gap-6 lg:gap-10">
          <a
            href="/"
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
            >/ Home</a
          >
          <h1 class="text-xs font-mono uppercase tracking-[0.2em] text-stone-500">Résumé / 2026</h1>
        </div>
        <div class="flex items-center gap-4">
          <ThemeToggle />
        </div>
      </header>

      <div id="profile-section" class="border-b border-stone-200 dark:border-stone-800 pb-16">
        <Profile client:load />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <div class="lg:col-span-8 flex flex-col gap-16 lg:gap-20 min-w-0">
          <Experience client:load />
          <Projects client:load variant="compact" />
        </div>

        <aside class="lg:col-span-4 lg:self-start lg:border-l lg:border-stone-200 dark:lg:border-stone-800 lg:pl-12 min-w-0">
          <section id="skills-section" class="scroll-mt-20">
            <Skills client:load />
          </section>
        </aside>
      </div>
    </main>

    <Footer client:load />

  </body>
</html>

---
import { getCollection } from "astro:content";
import { Footer } from "../../components/Footer";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteIcons from "../../components/SiteIcons.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import "../../styles/tailwind.css";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft && (post.data.tags ?? []).includes("for-fun"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <SiteIcons />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Roasts, jokes, asides, and other light writing."
    />
    <title>For fun 🥳 - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <SiteHeader items={[{ label: "Home", href: "/" }, { label: "For fun 🥳" }]} />
    <main class="w-full flex-1 mt-8 mb-12">
      <div class="chrome-width">
        <div class="structural-border border-t-0 p-8 md:p-12">
        <div class="mx-auto w-full max-w-3xl space-y-12">
        <header class="space-y-4">
          <h1 class="text-5xl font-heading tracking-tighter">For fun 🥳</h1>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-stone-700 dark:text-stone-400">
            Roasts · jokes · asides
          </p>
          <p class="text-lg text-stone-700 dark:text-stone-400 leading-relaxed font-sans">
            Amusing content for the discerning mind.
          </p>
        </header>

        {
          posts.length === 0 ? (
            <p class="text-sm text-stone-700 dark:text-stone-400">Nothing tagged for fun yet.</p>
          ) : (
            <ul class="m-0 list-none space-y-0 divide-y divide-stone-200 p-0 dark:divide-stone-800" role="list">
              {posts.map((post) => (
                <li class="py-8 first:pt-0">
                  <a
                    href={`/blog/posts/${post.id}`}
                    class="group flex flex-col gap-2 no-underline text-inherit sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
                  >
                    <div class="space-y-2 min-w-0">
                      <h2 class="font-heading text-2xl tracking-tight text-stone-900 underline-offset-4 group-hover:underline decoration-stone-300 dark:text-stone-100">
                        {post.data.title}
                      </h2>
                      {post.data.description && (
                        <p class="text-sm leading-relaxed text-stone-700 dark:text-stone-400">
                          {post.data.description}
                        </p>
                      )}
                    </div>
                    <span class="shrink-0 font-mono text-[11px] uppercase tracking-widest text-stone-600 dark:text-stone-400">
                      {post.data.pubDate.toISOString().slice(0, 10)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        </div>
        </div>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

---
import { Footer } from "../../components/Footer";
import NoiseOverlay from "../../components/NoiseOverlay.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import ThemeToggleBar from "../../components/ThemeToggleBar.astro";
import { forFunPages } from "../../lib/for-fun";
import "../../styles/tailwind.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <meta
      name="description"
      content="Light pages that do not belong on the résumé — roasts, jokes, and other asides."
    />
    <title>For fun - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <NoiseOverlay />
    <main class="w-full flex-1 mt-8 mb-12">
      <ThemeToggleBar maxWidth="max-w-5xl" />
      <div
        class="mx-auto max-w-5xl px-6 md:px-10 py-12 structural-border border-t-0 md:p-12 space-y-12"
      >
        <nav
          class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4"
        >
          <a
            href="/"
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
            >/ Home</a
          >
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-stone-300 dark:text-stone-700"
            >For fun</span
          >
        </nav>

        <header class="space-y-4 max-w-3xl">
          <h1 class="text-5xl font-heading tracking-tighter">For fun</h1>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">
            Not the résumé · not the manifesto
          </p>
          <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed font-sans">
            Amusing content for the discerning mind.
          </p>
        </header>

        <ul class="m-0 list-none space-y-0 divide-y divide-stone-200 p-0 dark:divide-stone-800" role="list">
          {
            forFunPages.map((page) => (
              <li class="py-8 first:pt-0">
                <a
                  href={page.href}
                  class="group flex flex-col gap-2 no-underline text-inherit sm:flex-row sm:items-baseline sm:justify-between sm:gap-8"
                >
                  <div class="space-y-2 min-w-0">
                    <h2 class="font-heading text-2xl tracking-tight text-stone-900 group-hover:underline decoration-stone-300 underline-offset-4 dark:text-stone-100">
                      {page.title}
                    </h2>
                    <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-400 max-w-2xl">
                      {page.tagline}
                    </p>
                  </div>
                  <span class="font-mono text-[10px] uppercase tracking-widest text-stone-400 shrink-0">
                    {page.dateLabel}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

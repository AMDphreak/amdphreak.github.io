---
import { Philosophy } from "../../components/Philosophy";
import { Footer } from "../../components/Footer";
import SiteHeader from "../../components/SiteHeader.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import "../../styles/tailwind.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Philosophy - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <SiteHeader items={[{ label: "Home", href: "/" }, { label: "Philosophy" }]} />
    <main class="w-full flex-1 mt-8 mb-12">
      <div class="chrome-width">
        <div class="structural-border border-t-0 p-8 md:p-12 space-y-8">
          <Philosophy client:load />
        </div>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

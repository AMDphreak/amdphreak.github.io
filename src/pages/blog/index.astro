---
import { Footer } from "../../components/Footer";
import NoiseOverlay from "../../components/NoiseOverlay.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import ThemeToggleBar from "../../components/ThemeToggleBar.astro";
import "../../styles/tailwind.css";

const choices = [
  {
    title: "Archived copies",
    tagline: "WordPress archive on this site",
    description:
      "Verbatim captures of pages and posts from ryanjohnson.website, preserved for browsing here.",
    href: "/wordpress-archive",
    external: false,
    cta: "Browse archive",
  },
  {
    title: "Continuing blog",
    tagline: "New writing on ryanjohnson.dev",
    description:
      "Static posts published on this site going forward — the long-term home after WordPress.",
    href: "/blog/posts",
    external: false,
    cta: "Read posts",
  },
  {
    title: "Feedback Hub filings",
    tagline: "Clear-web mirror of Hub submissions",
    description:
      "Catalog of Microsoft Feedback Hub items documented here — Hub has no owner API or public HTML pages.",
    href: "/feedback",
    external: false,
    cta: "Browse filings",
  },
  {
    title: "Live WordPress",
    tagline: "ryanjohnson.website",
    description:
      "The currently live WordPress blog. Still the source of truth until archival and migration are complete.",
    href: "https://www.ryanjohnson.website/posts",
    external: true,
    cta: "Open live site",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <NoiseOverlay />
    <main class="w-full flex-1 mt-8 mb-12">
      <ThemeToggleBar container maxWidth="max-w-4xl" />
      <div class="container mx-auto px-6 py-12 max-w-4xl structural-border border-t-0 p-8 md:p-12 space-y-12">
        <nav
          class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4"
        >
          <a
            href="/"
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
            >/ Home</a
          >
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-stone-300 dark:text-stone-700"
            >Blog</span
          >
        </nav>

        <header class="space-y-4 max-w-3xl">
          <h1 class="text-5xl font-heading tracking-tighter">Blog</h1>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">
            Archive · continue · live
          </p>
          <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed font-sans">
            Choose how you want to read: archived WordPress copies on this site, new static posts
            here, or the live WordPress site.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-px bg-stone-200 dark:bg-stone-800 border border-stone-200 dark:border-stone-800">
          {
            choices.map((choice) => (
              <div class="bg-background p-8 space-y-4">
                <div class="space-y-2">
                  <p class="font-mono text-[10px] uppercase tracking-widest text-stone-400">
                    {choice.tagline}
                  </p>
                  <h2 class="text-2xl font-heading tracking-tight">{choice.title}</h2>
                  <p class="text-sm text-stone-600 dark:text-stone-400 leading-relaxed max-w-2xl">
                    {choice.description}
                  </p>
                </div>
                <a
                  href={choice.href}
                  target={choice.external ? "_blank" : undefined}
                  rel={choice.external ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.2em] text-stone-900 dark:text-stone-100 hover:opacity-70 transition-opacity"
                >
                  {choice.cta}
                  <span aria-hidden="true">{choice.external ? "↗" : "→"}</span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

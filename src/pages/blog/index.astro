---
import { Footer } from "../../components/Footer";
import SiteHeader from "../../components/SiteHeader.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import "../../styles/tailwind.css";

const liveBlog = "https://www.ryanjohnson.website/posts";

const choices = [
  {
    title: "Posts",
    tagline: "Writing on this site",
    description: "Essays, notes, and posts published on ryanjohnson.dev.",
    href: "/blog/posts",
    external: false,
    actions: [{ label: "Read posts", href: "/blog/posts", external: false }],
  },
  {
    title: "Feedback Hub filings",
    tagline: "Clear-web mirror",
    description:
      "Catalog of Microsoft Feedback Hub items documented here. Hub has no owner API or public HTML pages.",
    href: "/feedback",
    external: false,
    actions: [{ label: "Browse filings", href: "/feedback", external: false }],
  },
  {
    title: "Old WordPress Blog",
    tagline: "ryanjohnson.website",
    description:
      "No longer the source of truth. New posts are published on this site. If a post lands on the old blog by accident, it gets imported later.",
    href: liveBlog,
    external: true,
    actions: [
      { label: "Archive", href: "/wordpress-archive", external: false },
      { label: "Live site", href: liveBlog, external: true },
    ],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <SiteHeader items={[{ label: "Home", href: "/" }, { label: "Blog" }]} />
    <main class="w-full flex-1 mt-8 mb-12">
      <div class="chrome-width">
        <div class="structural-border border-t-0 p-8 md:p-12">
        <div class="mx-auto w-full max-w-3xl space-y-12">
        <header class="space-y-4">
          <h1 class="text-5xl font-heading tracking-tighter">Blog</h1>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-stone-700 dark:text-stone-400">
            Essays · notes · ideas
          </p>
          <p class="text-lg text-stone-700 dark:text-stone-400 leading-relaxed font-sans">
            Inward writing on this site: ideas, notes, and essays. New posts are published here.
          </p>
        </header>

        <div class="grid grid-cols-1 gap-px bg-stone-200 dark:bg-stone-800 border border-stone-200 dark:border-stone-800">
          {
            choices.map((choice) => (
              <div class="bg-background p-8 space-y-4">
                <div class="space-y-2">
                  <p class="font-mono text-[11px] uppercase tracking-widest text-stone-600 dark:text-stone-400">
                    {choice.tagline}
                  </p>
                  <h2 class="text-2xl font-heading tracking-tight">
                    <a
                      href={choice.href}
                      target={choice.external ? "_blank" : undefined}
                      rel={choice.external ? "noopener noreferrer" : undefined}
                      class="text-foreground hover:underline decoration-stone-300 underline-offset-4"
                    >
                      {choice.title}
                    </a>
                  </h2>
                  <p class="text-sm text-stone-700 dark:text-stone-400 leading-relaxed">
                    {choice.description}
                  </p>
                </div>
                <div class="flex flex-wrap gap-4">
                  {choice.actions.map((action) => (
                    <a
                      href={action.href}
                      target={action.external ? "_blank" : undefined}
                      rel={action.external ? "noopener noreferrer" : undefined}
                      class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-stone-900 dark:text-stone-100 hover:opacity-70 transition-opacity"
                    >
                      {action.label}
                      <span aria-hidden="true">{action.external ? "↗" : "→"}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        </div>
        </div>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

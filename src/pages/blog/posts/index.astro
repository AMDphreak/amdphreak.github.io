---
import { getCollection } from "astro:content";
import { tagIdToHref } from "@content-tags/core";
import { Footer } from "../../../components/Footer";
import NoiseOverlay from "../../../components/NoiseOverlay.astro";
import ThemeScript from "../../../components/ThemeScript.astro";
import ThemeToggleBar from "../../../components/ThemeToggleBar.astro";
import { buildSiteTagIndex } from "../../../lib/content-tags";
import "../../../styles/tailwind.css";

const tagIndex = await buildSiteTagIndex();
const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Posts - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <NoiseOverlay />
    <main class="w-full flex-1 mt-8 mb-12">
      <ThemeToggleBar container maxWidth="max-w-4xl" />
      <div class="container mx-auto px-6 py-12 max-w-4xl structural-border border-t-0 p-8 md:p-12 space-y-12">
        <nav
          class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4"
        >
          <div class="flex items-center gap-4">
            <a
              href="/"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Home</a
            >
            <a
              href="/blog"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Blog</a
            >
          </div>
          <div class="flex items-center gap-4">
            <a
              href="/tags"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Tags</a
            >
            <span
              class="font-mono text-[10px] uppercase tracking-widest text-stone-300 dark:text-stone-700"
              >Posts</span
            >
          </div>
        </nav>

        <header class="space-y-4 max-w-3xl">
          <h1 class="text-5xl font-heading tracking-tighter">Continuing blog</h1>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">
            Static posts · ryanjohnson.dev ·{" "}
            <a href="/tags" class="hover:text-stone-900 dark:hover:text-stone-100"
              >browse tags</a
            >
          </p>
          <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed font-sans">
            New writing published on this site. For older WordPress material, see the{" "}
            <a
              href="/wordpress-archive"
              class="underline decoration-stone-300 underline-offset-4"
              >archive</a
            >{" "}
            or the{" "}
            <a
              href="https://www.ryanjohnson.website/posts"
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-stone-300 underline-offset-4"
              >live site</a
            >.
          </p>
        </header>

        {
          allPosts.length === 0 ? (
            <p class="text-sm text-stone-500">No posts yet.</p>
          ) : (
            <ul class="space-y-6 m-0 p-0 list-none divide-y divide-stone-200 dark:divide-stone-800">
              {allPosts.map((post) => (
                <li class="py-6 first:pt-0">
                  <a
                    href={`/blog/posts/${post.id}`}
                    class="font-heading text-2xl tracking-tight text-foreground hover:underline decoration-stone-300 underline-offset-4"
                  >
                    {post.data.title}
                  </a>
                  <p class="font-mono text-[10px] uppercase tracking-widest text-stone-400 mt-2">
                    {post.data.pubDate.toISOString().slice(0, 10)}
                  </p>
                  {post.data.description && (
                    <p class="mt-2 text-sm text-stone-600 dark:text-stone-400 leading-relaxed">
                      {post.data.description}
                    </p>
                  )}
                  {(post.data.tags?.length ?? 0) > 0 && (
                    <ul class="mt-3 flex flex-wrap gap-3 list-none m-0 p-0">
                      {post.data.tags.map((tagId) => {
                        const label = tagIndex.byId.get(tagId)?.label ?? tagId;
                        return (
                          <li>
                            <a
                              href={tagIdToHref(tagId)}
                              class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
                            >
                              {label}
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

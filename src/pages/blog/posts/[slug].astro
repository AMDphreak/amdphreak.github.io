---
import { getCollection, render } from "astro:content";
import { getTagsForPost } from "@content-tags/core";
import { Footer } from "../../../components/Footer";
import { PostTags } from "../../../components/PostTags";
import NoiseOverlay from "../../../components/NoiseOverlay.astro";
import ThemeScript from "../../../components/ThemeScript.astro";
import ThemeToggleBar from "../../../components/ThemeToggleBar.astro";
import { buildSiteTagIndex } from "../../../lib/content-tags";
import "../../../styles/tailwind.css";

type MdPost = Awaited<ReturnType<typeof getCollection<"blog">>>[number];
type CmkPost = Awaited<ReturnType<typeof getCollection<"blogCmk">>>[number];

export async function getStaticPaths() {
  const mdPosts = await getCollection("blog");
  const cmkPosts = await getCollection("blogCmk");
  const tagIndex = await buildSiteTagIndex();
  return [
    ...mdPosts
      .filter((p) => !p.data.draft)
      .map((post) => ({
        params: { slug: post.id },
        props: { kind: "md" as const, post, tagIndex },
      })),
    ...cmkPosts
      .filter((p) => !p.data.draft)
      .map((post) => ({
        params: { slug: post.id },
        props: { kind: "cmk" as const, post, tagIndex },
      })),
  ];
}

const { kind, post, tagIndex } = Astro.props as
  | { kind: "md"; post: MdPost; tagIndex: Awaited<ReturnType<typeof buildSiteTagIndex>> }
  | { kind: "cmk"; post: CmkPost; tagIndex: Awaited<ReturnType<typeof buildSiteTagIndex>> };

const Content = kind === "md" ? (await render(post)).Content : null;
const cmkHtml = kind === "cmk" ? post.data.html : null;
const postTags = kind === "md" ? getTagsForPost(tagIndex, post.id) : [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} - Ryan Johnson</title>
    <ThemeScript />
    <style is:global>
      .cmk-render .cmk-frontmatter {
        display: none;
      }
      .cmk-render .cmk-cites a,
      .cmk-render .cmk-cite {
        font-size: 0.75em;
        text-decoration: none;
      }
      .cmk-render .cmk-sources {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgb(214 211 209);
      }
      .dark .cmk-render .cmk-sources {
        border-top-color: rgb(41 37 36);
      }
      .cmk-render .cmk-sources-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
      }
      .cmk-render .cmk-sources-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 0.75rem;
      }
      .cmk-render .cmk-source-index {
        font-family: ui-monospace, monospace;
        margin-right: 0.35rem;
        opacity: 0.7;
      }
    </style>
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <NoiseOverlay />
    <main class="w-full flex-1 mt-8 mb-12">
      <ThemeToggleBar container maxWidth="max-w-3xl" />
      <div class="container mx-auto px-6 py-12 max-w-3xl structural-border border-t-0 p-8 md:p-12 space-y-10">
        <nav
          class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4"
        >
          <a
            href="/blog/posts"
            class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
            >/ Posts</a
          >
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-stone-300 dark:text-stone-700"
            >Blog</span
          >
        </nav>

        <article class="space-y-8">
          <header class="space-y-3">
            <h1 class="text-4xl md:text-5xl font-heading tracking-tighter">{post.data.title}</h1>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">
              {post.data.pubDate.toISOString().slice(0, 10)}
            </p>
            {
              postTags.length > 0 && (
                <div class="pt-2">
                  <PostTags client:load tags={postTags} />
                </div>
              )
            }
          </header>
          <div
            class="prose prose-stone dark:prose-invert max-w-none space-y-4 text-stone-700 dark:text-stone-300 leading-relaxed font-sans"
          >
            {Content ? <Content /> : null}
            {cmkHtml ? <div class="cmk-render" set:html={cmkHtml} /> : null}
          </div>
        </article>
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

---
import { tagIdToHref } from "@content-tags/core";
import { Footer } from "../../components/Footer";
import NoiseOverlay from "../../components/NoiseOverlay.astro";
import ThemeScript from "../../components/ThemeScript.astro";
import ThemeToggleBar from "../../components/ThemeToggleBar.astro";
import { buildSiteTagIndex } from "../../lib/content-tags";
import type { ResolvedTag } from "@content-tags/core";
import "../../styles/tailwind.css";

const index = await buildSiteTagIndex();

function renderTree(nodes: ResolvedTag[]): string {
  if (!nodes.length) return "";
  const items = nodes
    .map((node) => {
      const count = index.postsByTag.get(node.id)?.length ?? 0;
      const children = renderTree(node.children);
      return `<li class="py-1">
        <a class="font-heading text-lg tracking-tight hover:underline decoration-stone-300 underline-offset-4" href="${tagIdToHref(node.id)}">${node.label}</a>
        <span class="font-mono text-[10px] uppercase tracking-widest text-stone-400 ml-2">(${count})</span>
        ${children}
      </li>`;
    })
    .join("");
  return `<ul class="list-none m-0 p-0 pl-4 space-y-1 border-l border-stone-200 dark:border-stone-800">${items}</ul>`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tags - Ryan Johnson</title>
    <ThemeScript />
  </head>
  <body
    class="bg-background text-foreground selection:bg-stone-200 selection:text-stone-900 dark:selection:bg-stone-800 dark:selection:text-stone-100 min-h-screen flex flex-col"
  >
    <NoiseOverlay />
    <main class="w-full flex-1 mt-8 mb-12">
      <ThemeToggleBar container maxWidth="max-w-4xl" />
      <div class="container mx-auto px-6 py-12 max-w-4xl structural-border border-t-0 p-8 md:p-12 space-y-12">
        <nav
          class="flex items-center justify-between border-b border-stone-200 dark:border-stone-800 pb-4"
        >
          <div class="flex items-center gap-4">
            <a
              href="/"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Home</a
            >
            <a
              href="/blog"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Blog</a
            >
            <a
              href="/blog/posts"
              class="font-mono text-[10px] uppercase tracking-[0.3em] text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 transition-colors"
              >/ Posts</a
            >
          </div>
          <span
            class="font-mono text-[10px] uppercase tracking-widest text-stone-300 dark:text-stone-700"
            >Tags</span
          >
        </nav>

        <header class="space-y-4 max-w-3xl">
          <h1 class="text-5xl font-heading tracking-tighter">Tags</h1>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-500">
            Hierarchical taxonomy · continuing blog
          </p>
          <p class="text-lg text-stone-600 dark:text-stone-400 leading-relaxed font-sans">
            Browse posts by topic. Counts include posts tagged on a node or any of its descendants.
          </p>
        </header>

        <div class="text-stone-700 dark:text-stone-300" set:html={renderTree(index.roots)} />
      </div>
    </main>

    <Footer client:load />
  </body>
</html>

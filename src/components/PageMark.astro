---
/**
 * One monochrome stone behind the page. It is fixed to the viewport and
 * aligned to the chrome column. A script moves it onto body so a z-index
 * on the header or hero cannot paint it over the text.
 *
 * Size and place are a fraction of that column (cqw), so window size and
 * browser zoom keep the same relationship to the column. 47.5cqw is the
 * desktop scale of the old 45vh mark at 1.5× (67.5vh) when the column is
 * 80rem and the viewport is 900px tall.
 */
---

<div class="page-mark" data-page-mark aria-hidden="true">
  <div class="page-mark__slot">
    <div class="page-mark__rise">
      <div class="page-mark__drift">
        <img
          class="page-mark__stone"
          src="/brand/ryan-runescape-logo-mono.svg"
          alt=""
          width="1647"
          height="1648"
          decoding="async"
          draggable="false"
        />
      </div>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var mark = document.currentScript && document.currentScript.previousElementSibling;
    if (!mark || !mark.hasAttribute("data-page-mark")) return;
    if (mark.parentNode !== document.body) document.body.insertBefore(mark, document.body.firstChild);
  })();
</script>

<style>
  /*
   * z-index 0 sits above the body background. A negative z-index paints
   * behind that background, so the stone disappears. The rule below lifts
   * the page columns above the stone. Home's main is not in that lift:
   * its wash and its copy join the body's stack so the one grain layer
   * can sit between them. The fixed frame keeps its own layer.
   */
  .page-mark {
    position: fixed;
    z-index: 0;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: var(--chrome-max);
    margin-inline: auto;
    pointer-events: none;
    container-type: inline-size;
  }

  :global(body > :not([data-page-mark]):not(.fixed):not(:has(.home-software))) {
    position: relative;
    z-index: 1;
  }

  /*
   * Center on 70% of the column. Without a home hero, the top sits 4% of
   * the stone's height above the viewport.
   *
   * On the home hero, the frame is as tall as that section and fixed to the
   * top of the viewport, so 50% of the frame is the hero's vertical center
   * and does not follow the hero as it scrolls. The stone's own center
   * (50% from its top edge) is placed on that line, then shifted up by 8%
   * of the stone. The drift moves the stone down by that same 8%, so the
   * travel ends on the hero center. The size stays in cqw; the anchor is
   * the hero's height, not a px top.
   */
  :global([data-home-hero]) {
    anchor-name: --home-hero;
  }

  .page-mark__slot {
    --page-mark-size: 47.5cqw;
    --page-mark-shift: -8%;
    position: absolute;
    top: calc(var(--page-mark-size) * -0.04);
    left: 70%;
    width: var(--page-mark-size);
    height: var(--page-mark-size);
    transform: translateX(-50%);
  }

  @supports (height: anchor-size(--home-hero height)) {
    :global(body:has([data-home-hero])) .page-mark {
      position-anchor: --home-hero;
      height: anchor-size(--home-hero height);
    }

    :global(body:has([data-home-hero])) .page-mark__slot {
      top: 50%;
      transform: translate(-50%, calc(-50% + var(--page-mark-shift)));
    }
  }

  .page-mark__rise,
  .page-mark__drift,
  .page-mark__stone {
    width: 100%;
    height: 100%;
  }

  /* Same fade and rise as the hero name: 450ms ease-out, no extra delay. */
  :global(html.load-hold) .page-mark__rise {
    opacity: 0;
  }

  :global(html.load-enter) .page-mark__rise {
    animation: page-mark-rise 450ms ease-out both;
  }

  /*
   * A short drift, not a slide. Over the whole scroll the stone moves
   * 10% of its width left and 8% of its height down (about 5% and 4%
   * of the column). The shape does not change.
   */
  .page-mark__drift {
    animation-name: page-mark-drift;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
  }

  /*
   * Fade from 0.2 to 0 over the first 90rem of scroll. That passes the
   * bottom of Photography (about 85rem), so the stone is still visible
   * through Software and Photography and is gone after that section.
   * A length range stays the same on a short page and a long page.
   * The drift above still covers the whole scroll.
   */
  .page-mark__stone {
    display: block;
    max-width: none;
    opacity: 0.2;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    animation-name: page-mark-fade;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: 0 90rem;
  }

  @keyframes page-mark-rise {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes page-mark-drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-10%, 8%);
    }
  }

  @keyframes page-mark-fade {
    from {
      opacity: 0.2;
    }
    to {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.load-hold) .page-mark__rise {
      opacity: 1;
    }
    :global(html.load-enter) .page-mark__rise,
    .page-mark__drift,
    .page-mark__stone {
      animation: none;
    }
    .page-mark__drift {
      transform: none;
    }
    .page-mark__stone {
      opacity: 0.2;
    }
  }
</style>

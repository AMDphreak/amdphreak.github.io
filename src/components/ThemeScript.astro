---
import instrumentSansLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import instrumentSansItalic from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-italic.woff2?url";
import spaceGroteskLatin from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import spaceMonoLatin from "@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url";
import spaceMono700 from "@fontsource/space-mono/files/space-mono-latin-700-normal.woff2?url";
import spaceMonoItalic from "@fontsource/space-mono/files/space-mono-latin-400-italic.woff2?url";
import spaceMono700Italic from "@fontsource/space-mono/files/space-mono-latin-700-italic.woff2?url";
import LoadEntrance from "./LoadEntrance.astro";

const latin =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

function face(family: string, style: string, weight: string, display: string, url: string) {
  return `@font-face{font-family:"${family}";font-style:${style};font-weight:${weight};font-display:${display};src:url("${url}") format("woff2");unicode-range:${latin};}`;
}

const fontCss = [
  face("Instrument Sans", "normal", "400 700", "block", instrumentSansLatin),
  face("Space Grotesk", "normal", "300 700", "block", spaceGroteskLatin),
  face("Space Mono", "normal", "400", "block", spaceMonoLatin),
  face("Instrument Sans", "italic", "400 700", "optional", instrumentSansItalic),
  face("Space Mono", "normal", "700", "optional", spaceMono700),
  face("Space Mono", "italic", "400", "optional", spaceMonoItalic),
  face("Space Mono", "italic", "700", "optional", spaceMono700Italic),
].join("");
---

<script is:inline>
  (function () {
    var theme = "light";
    try {
      var saved = localStorage.getItem("theme");
      if (saved) theme = saved;
      else if (matchMedia("(prefers-color-scheme: dark)").matches) theme = "dark";
    } catch (e) {}
    var root = document.documentElement;
    if (theme === "dark") root.classList.add("dark");
    else root.classList.remove("dark");
    root.style.colorScheme = theme;
    root.style.backgroundColor = theme === "dark" ? "#0c0a09" : "#ffffff";
  })();
</script>
<LoadEntrance />
<link rel="preload" as="font" type="font/woff2" href={instrumentSansLatin} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={spaceGroteskLatin} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={spaceMonoLatin} crossorigin />
<style is:inline set:html={fontCss}></style>
<script is:inline>
  (function () {
    const applyTheme = (theme, save = false) => {
      if (theme === "dark") document.documentElement.classList.add("dark");
      else document.documentElement.classList.remove("dark");

      document.documentElement.style.colorScheme = theme;
      document.documentElement.style.backgroundColor = theme === "dark" ? "#0c0a09" : "#ffffff";

      if (save && typeof localStorage !== "undefined") {
        localStorage.setItem("theme", theme);
      }
    };

    const getTheme = () => {
      const saved = typeof localStorage !== "undefined" ? localStorage.getItem("theme") : null;
      if (saved) return saved;
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    };

    applyTheme(getTheme());

    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
      applyTheme(e.matches ? "dark" : "light", true);
    });

    const REVEAL_MS = 450;

    let themeToggle = null;
    let activeTransition = null;
    let generation = 0;

    const revealOrigin = () => {
      if (!themeToggle) {
        return { x: window.innerWidth / 2, y: window.innerHeight / 2 };
      }
      const rect = themeToggle.getBoundingClientRect();
      return {
        x: rect.left + rect.width / 2,
        y: rect.top + rect.height / 2,
      };
    };

    const toggleTheme = () => {
      const isDark = document.documentElement.classList.contains("dark");
      const newTheme = isDark ? "light" : "dark";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || reduceMotion) {
        applyTheme(newTheme, true);
        return;
      }

      // One document VT at a time: skip the in-flight reveal, then start a new one.
      if (activeTransition) {
        activeTransition.skipTransition();
        activeTransition = null;
      }

      const id = ++generation;
      const { x, y } = revealOrigin();
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y),
      );

      document.documentElement.classList.add("theme-transitioning");

      try {
        const transition = document.startViewTransition(() => {
          applyTheme(newTheme, true);
        });
        activeTransition = transition;

        transition.ready.then(() => {
          if (id !== generation) return;

          // GPU-cheap: animate a single clip-path on the new root snapshot.
          document.documentElement.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: REVEAL_MS,
              easing: "ease-in-out",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        });

        transition.finished.finally(() => {
          if (id !== generation) return;
          document.documentElement.classList.remove("theme-transitioning");
          activeTransition = null;
        });
      } catch {
        applyTheme(newTheme, true);
        document.documentElement.classList.remove("theme-transitioning");
        activeTransition = null;
      }
    };

    const initToggle = () => {
      themeToggle = document.getElementById("theme-toggle");
      if (!themeToggle) return;

      themeToggle.addEventListener("click", toggleTheme);
      themeToggle.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggleTheme();
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initToggle);
    } else {
      initToggle();
    }

    const navPath = (url) => {
      if (!url) return "";
      try {
        let path = new URL(url, location.href).pathname;
        if (path.length > 1 && path.endsWith("/")) path = path.slice(0, -1);
        return path || "/";
      } catch {
        return "";
      }
    };

    // Up the tree when the destination path is a strict ancestor. "/" is an ancestor of every other path.
    const navType = (fromUrl, toUrl) => {
      const from = navPath(fromUrl);
      const to = navPath(toUrl);
      if (!from || !to || from === to) return "cover";
      if (to === "/" || from.startsWith(to + "/")) return "reveal";
      return "cover";
    };

    const tagNavigation = (viewTransition, fromUrl, toUrl) => {
      if (!viewTransition || !viewTransition.types) return;
      viewTransition.types.add(navType(fromUrl, toUrl));
    };

    window.addEventListener("pageswap", (event) => {
      const activation = event.activation;
      if (!activation) return;
      tagNavigation(
        event.viewTransition,
        activation.from && activation.from.url,
        activation.entry && activation.entry.url,
      );
    });

    window.addEventListener("pagereveal", (event) => {
      const activation =
        event.activation || (window.navigation && window.navigation.activation);
      if (!activation) return;
      tagNavigation(
        event.viewTransition,
        activation.from && activation.from.url,
        activation.entry && activation.entry.url,
      );
    });
  })();
</script>

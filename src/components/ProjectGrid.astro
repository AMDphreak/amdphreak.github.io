---
import type { HubDestination } from "../lib/hub-destinations";

interface Props {
  destinations: HubDestination[];
}

const { destinations } = Astro.props;

const screenshotSizes =
  "(max-width: 639px) min(22rem, 90vw), (max-width: 1023px) min(22rem, 45vw), (max-width: 1279px) min(22rem, 30vw), 24rem";

function screenshotSrcset(id: string) {
  return `/products/${id}-400.webp 400w, /products/${id}-800.webp 800w`;
}
---

<div class="flex flex-wrap items-stretch justify-center gap-8 lg:gap-10">
  {
    destinations.map((dest) => (
      <article class="group flex w-full max-w-[22rem] sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.75rem)] flex-none flex-col rounded-[2rem] bg-stone-100/80 dark:bg-stone-900/60 p-3 sm:p-3.5 pb-5 shadow-sm ring-1 ring-stone-200/80 dark:ring-stone-800/80">
        <div class="relative flex flex-1 flex-col">
          {dest.screenshot ? (
            <a
              href={dest.href}
              target={dest.external ? "_blank" : undefined}
              rel={dest.external ? "noopener noreferrer" : undefined}
              class="block overflow-hidden rounded-[1.35rem] bg-stone-200 dark:bg-stone-950 aspect-[4/3]"
            >
              <img
                src={dest.screenshot}
                srcset={screenshotSrcset(dest.id)}
                sizes={screenshotSizes}
                alt={`Screenshot of ${dest.name}`}
                width={800}
                height={600}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top origin-top transition-transform duration-700 ease-out will-change-transform group-hover:scale-[1.03]"
              />
            </a>
          ) : (
            <a
              href={dest.href}
              target={dest.external ? "_blank" : undefined}
              rel={dest.external ? "noopener noreferrer" : undefined}
              class="relative flex aspect-[4/3] min-h-[20rem] items-start overflow-hidden rounded-[1.35rem] bg-stone-200 no-underline dark:bg-stone-950"
            >
              <svg
                class="pointer-events-none absolute inset-0 h-full w-full text-stone-500/55 dark:text-stone-400/40"
                aria-hidden="true"
              >
                <defs>
                  {dest.pattern === "diag" && (
                    <pattern id={`${dest.id}-pat`} width="14" height="14" patternUnits="userSpaceOnUse">
                      <path d="M-2 14 L14 -2 M-2 2 L2 -2" stroke="currentColor" stroke-width="1.25" />
                    </pattern>
                  )}
                  {dest.pattern === "grid" && (
                    <pattern id={`${dest.id}-pat`} width="18" height="18" patternUnits="userSpaceOnUse">
                      <path d="M18 0 H0 V18" fill="none" stroke="currentColor" stroke-width="1" />
                    </pattern>
                  )}
                  {dest.pattern === "rings" && (
                    <pattern id={`${dest.id}-pat`} width="36" height="36" patternUnits="userSpaceOnUse">
                      <circle cx="18" cy="18" r="8" fill="none" stroke="currentColor" stroke-width="1.25" />
                      <circle cx="18" cy="18" r="2" fill="currentColor" />
                    </pattern>
                  )}
                  {dest.pattern === "cross" && (
                    <pattern id={`${dest.id}-pat`} width="20" height="20" patternUnits="userSpaceOnUse">
                      <path d="M10 4 V16 M4 10 H16" stroke="currentColor" stroke-width="1.25" />
                    </pattern>
                  )}
                  {dest.pattern === "chevron" && (
                    <pattern id={`${dest.id}-pat`} width="22" height="12" patternUnits="userSpaceOnUse">
                      <path d="M0 10 L11 2 L22 10" fill="none" stroke="currentColor" stroke-width="1.25" />
                    </pattern>
                  )}
                  {dest.pattern === "waves" && (
                    <pattern id={`${dest.id}-pat`} width="40" height="16" patternUnits="userSpaceOnUse">
                      <path d="M0 8 Q10 0 20 8 T40 8" fill="none" stroke="currentColor" stroke-width="1.25" />
                    </pattern>
                  )}
                  {(dest.pattern === "dots" || !dest.pattern) && (
                    <pattern id={`${dest.id}-pat`} width="16" height="16" patternUnits="userSpaceOnUse">
                      <circle cx="3" cy="3" r="1.5" fill="currentColor" />
                    </pattern>
                  )}
                </defs>
                <rect width="100%" height="100%" fill={`url(#${dest.id}-pat)`} />
              </svg>
              <p class="relative z-10 px-6 pt-6 font-heading text-3xl font-medium leading-tight tracking-tight text-foreground">
                {dest.name}
              </p>
            </a>
          )}
          <div class="relative -mt-[55%] flex min-h-[55%] flex-1 flex-col gap-3 rounded-b-[1.35rem] bg-gradient-to-t from-background from-35% via-background/95 via-55% to-transparent px-5 pb-1 pt-16">
            <a
              href={dest.href}
              target={dest.external ? "_blank" : undefined}
              rel={dest.external ? "noopener noreferrer" : undefined}
              class="group/title inline-flex items-baseline gap-2 no-underline"
            >
              <h3 class="text-xl font-heading font-medium tracking-tight text-foreground underline-offset-4 group-hover/title:underline decoration-stone-300">
                {dest.name}
              </h3>
              {dest.external && (
                <span class="font-mono text-[10px] text-stone-600 opacity-70 dark:text-stone-400" aria-hidden="true">
                  ↗
                </span>
              )}
            </a>
            <p class="text-sm leading-relaxed text-stone-700 dark:text-stone-400">{dest.tagline}</p>
            <div class="mt-auto flex flex-wrap gap-4 pt-3">
              <a
                href={dest.href}
                target={dest.external ? "_blank" : undefined}
                rel={dest.external ? "noopener noreferrer" : undefined}
                class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-700 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
              >
                {dest.actionLabel} →
              </a>
              {dest.secondaryHref && (
                <a
                  href={dest.secondaryHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-600 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
                >
                  {dest.secondaryLabel ?? "GitHub"} ↗
                </a>
              )}
              {dest.extraHref && (
                <a
                  href={dest.extraHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-600 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
                >
                  {dest.extraLabel ?? "More"} ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</div>

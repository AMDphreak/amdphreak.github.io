---
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  maxWidth?: string;
  container?: boolean;
}

const { maxWidth = "max-w-5xl", container = false } = Astro.props;
const base = container
  ? `container mx-auto px-6 ${maxWidth}`
  : `mx-auto w-full px-6 md:px-10 ${maxWidth}`;
---

<div class:list={[base, "flex justify-end mb-3"]}>
  <ThemeToggle />
</div>

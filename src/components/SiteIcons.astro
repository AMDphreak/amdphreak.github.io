<!--
  PNG is declared first and SVG last. Among icons a browser can decode, the
  last one wins. Chromium takes the SVG and keeps its transparency. Firefox
  does not use an SVG favicon, so it keeps the PNG. Both are monochrome copies.
  The color SVG, PNG, and WebP stay on disk. One artwork for both themes.
-->
<link
  rel="icon"
  type="image/png"
  href="/brand/ryan-runescape-logo-icon-square-mono.png"
  data-site-icon="png"
  data-href-light="/brand/ryan-runescape-logo-icon-square-mono.png"
  data-href-dark="/brand/ryan-runescape-logo-icon-square-mono.png"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/brand/ryan-runescape-logo-mono.svg"
  data-site-icon="svg"
  data-href-light="/brand/ryan-runescape-logo-mono.svg"
  data-href-dark="/brand/ryan-runescape-logo-mono.svg"
/>
<link
  rel="apple-touch-icon"
  href="/brand/ryan-runescape-logo-icon-square-mono.png"
  data-site-icon="apple"
  data-href-light="/brand/ryan-runescape-logo-icon-square-mono.png"
  data-href-dark="/brand/ryan-runescape-logo-icon-square-mono.png"
/>
<script is:inline>
  (function () {
    var root = document.documentElement;
    function isDark() {
      if (root.classList.contains("dark")) return true;
      try {
        var saved = localStorage.getItem("theme");
        if (saved === "dark") return true;
        if (saved === "light") return false;
      } catch (e) {}
      return window.matchMedia("(prefers-color-scheme: dark)").matches;
    }
    function apply() {
      var dark = isDark();
      var links = document.querySelectorAll("link[data-site-icon]");
      for (var i = 0; i < links.length; i++) {
        var link = links[i];
        var href = dark ? link.getAttribute("data-href-dark") : link.getAttribute("data-href-light");
        if (!href) continue;
        link.removeAttribute("media");
        if (link.getAttribute("href") !== href) link.setAttribute("href", href);
      }
      var alts = document.querySelectorAll("link[data-site-icon-alt]");
      for (var j = 0; j < alts.length; j++) alts[j].parentNode.removeChild(alts[j]);
    }
    apply();
    new MutationObserver(apply).observe(root, {
      attributes: true,
      attributeFilter: ["class"],
    });
  })();
</script>

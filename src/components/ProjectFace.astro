---
import type { HubDestination } from "../lib/hub-destinations";

interface Props {
  destination: HubDestination;
}

const { destination } = Astro.props;

const screenshotSizes =
  "(max-width: 639px) min(22rem, 90vw), 16rem";

function screenshotSrcset(id: string) {
  return `/products/${id}-400.webp 400w, /products/${id}-800.webp 800w`;
}
---

<div class="flex w-full max-w-xs flex-col gap-4">
  {
    destination.screenshot ? (
      <a
        href={destination.href}
        target={destination.external ? "_blank" : undefined}
        rel={destination.external ? "noopener noreferrer" : undefined}
        class="block aspect-square overflow-hidden bg-stone-200 dark:bg-stone-950"
      >
        <img
          src={destination.screenshot}
          srcset={screenshotSrcset(destination.id)}
          sizes={screenshotSizes}
          alt={`Screenshot of ${destination.name}`}
          width={800}
          height={600}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
        />
      </a>
    ) : (
      <a
        href={destination.href}
        target={destination.external ? "_blank" : undefined}
        rel={destination.external ? "noopener noreferrer" : undefined}
        class="relative flex aspect-square items-start overflow-hidden bg-stone-200 no-underline dark:bg-stone-950"
      >
        <svg
          class="pointer-events-none absolute inset-0 h-full w-full text-stone-500/55 dark:text-stone-400/40"
          aria-hidden="true"
        >
          <defs>
            {destination.pattern === "diag" && (
              <pattern id={`${destination.id}-pat`} width="14" height="14" patternUnits="userSpaceOnUse">
                <path d="M-2 14 L14 -2 M-2 2 L2 -2" stroke="currentColor" stroke-width="1.25" />
              </pattern>
            )}
            {destination.pattern === "grid" && (
              <pattern id={`${destination.id}-pat`} width="18" height="18" patternUnits="userSpaceOnUse">
                <path d="M18 0 H0 V18" fill="none" stroke="currentColor" stroke-width="1" />
              </pattern>
            )}
            {destination.pattern === "rings" && (
              <pattern id={`${destination.id}-pat`} width="36" height="36" patternUnits="userSpaceOnUse">
                <circle cx="18" cy="18" r="8" fill="none" stroke="currentColor" stroke-width="1.25" />
                <circle cx="18" cy="18" r="2" fill="currentColor" />
              </pattern>
            )}
            {destination.pattern === "cross" && (
              <pattern id={`${destination.id}-pat`} width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M10 4 V16 M4 10 H16" stroke="currentColor" stroke-width="1.25" />
              </pattern>
            )}
            {destination.pattern === "chevron" && (
              <pattern id={`${destination.id}-pat`} width="22" height="12" patternUnits="userSpaceOnUse">
                <path d="M0 10 L11 2 L22 10" fill="none" stroke="currentColor" stroke-width="1.25" />
              </pattern>
            )}
            {destination.pattern === "waves" && (
              <pattern id={`${destination.id}-pat`} width="40" height="16" patternUnits="userSpaceOnUse">
                <path d="M0 8 Q10 0 20 8 T40 8" fill="none" stroke="currentColor" stroke-width="1.25" />
              </pattern>
            )}
            {(destination.pattern === "dots" || !destination.pattern) && (
              <pattern id={`${destination.id}-pat`} width="16" height="16" patternUnits="userSpaceOnUse">
                <circle cx="3" cy="3" r="1.5" fill="currentColor" />
              </pattern>
            )}
          </defs>
          <rect width="100%" height="100%" fill={`url(#${destination.id}-pat)`} />
        </svg>
        <p class="relative z-10 px-5 py-5 font-heading text-3xl font-medium leading-tight tracking-tight text-foreground">
          {destination.name}
        </p>
      </a>
    )
  }
  <div class="flex flex-wrap gap-4">
    <a
      href={destination.href}
      target={destination.external ? "_blank" : undefined}
      rel={destination.external ? "noopener noreferrer" : undefined}
      class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-700 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
    >
      {destination.actionLabel} →
    </a>
    {
      destination.secondaryHref && (
        <a
          href={destination.secondaryHref}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-600 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
        >
          {destination.secondaryLabel ?? "GitHub"} ↗
        </a>
      )
    }
    {
      destination.extraHref && (
        <a
          href={destination.extraHref}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[10px] uppercase tracking-[0.2em] text-stone-600 transition-colors hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100"
        >
          {destination.extraLabel ?? "More"} ↗
        </a>
      )
    }
  </div>
</div>

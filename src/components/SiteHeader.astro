---
import Breadcrumb, { type Crumb } from "./Breadcrumb.astro";
import PageMark from "./PageMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

/**
 * Line under the whole header. Leave this on to test the header rule.
 * Breadcrumb links do not draw their own line, so both cannot show at once.
 */
const showHeaderRule = true;
---

<PageMark />
<header class="relative z-10">
  <div class="chrome-width pt-8 lg:pt-10">
    <div
      class:list={[
        "flex flex-wrap items-center justify-between gap-6 pb-6",
        showHeaderRule && "header-rule border-b dark:border-stone-800/80",
      ]}
    >
      <Breadcrumb items={items} />
      <ThemeToggle />
    </div>
  </div>
</header>

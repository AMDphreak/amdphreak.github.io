---
/**
 * First-load fade for main content. Cross-document view transitions skip it
 * so the page cover is the only motion.
 */
---

<noscript>
  <style>
    html.load-hold .hero-load > :not(script):not(style),
    html.load-hold .hero-load > astro-island > *,
    html.load-hold main > * {
      opacity: 1 !important;
    }
  </style>
</noscript>
<style is:inline>
  html.load-hold .hero-load > :not(script):not(style),
  html.load-hold .hero-load > astro-island > *,
  html.load-hold main > * {
    opacity: 0;
  }
  /* The island is display:contents, so the fade has to land on the list. */
  html.load-enter .hero-load > astro-island > * {
    animation: load-rise 450ms ease-out 110ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    html.load-hold .hero-load > :not(script):not(style),
    html.load-hold .hero-load > astro-island > *,
    html.load-hold main > * {
      opacity: 1;
    }
    html.load-enter .hero-load > astro-island > * {
      animation: none;
    }
  }
</style>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var started = false;
    var sawReveal = false;
    root.classList.add("load-hold");

    function reduced() {
      return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    }

    function showStill() {
      if (started) return;
      started = true;
      root.classList.remove("load-hold");
    }

    function showEntrance() {
      if (started) return;
      started = true;
      if (reduced()) {
        root.classList.remove("load-hold");
        return;
      }
      root.classList.add("load-enter");
      root.classList.remove("load-hold");
    }

    window.addEventListener("pagereveal", function (event) {
      sawReveal = true;
      if (event.viewTransition) showStill();
      else showEntrance();
    });

    window.addEventListener("DOMContentLoaded", function () {
      window.setTimeout(function () {
        if (!sawReveal) showEntrance();
      }, 400);
    });

    window.setTimeout(function () {
      if (!started) showEntrance();
    }, 1600);
  })();
</script>

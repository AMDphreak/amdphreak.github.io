  contentHtml: '\n<p>3 ways to embed Zeffy donate into website. Note, the black border will not show up in the website.</p>\n\n\n\n<h2 class="wp-block-heading">Button Popup</h2>\n\n\n\n<div style="border:1px solid black; padding:10px;"><button class="zeffy-btn" zeffy-form-link="https://www.zeffy.com/embed/donation-form/a16d1ca9-d260-4d5c-91a3-4522cb70e976?modal=true"">Donate</button></div>\n\n\n\n<h2 class="wp-block-heading">Thermometer</h2>\n\n\n\n<div style="border:1px solid black; padding:10px;"><div style="position:relative;overflow:hidden;width:100%;padding-top:120px;"><iframe title=\'Donation form powered by Zeffy\' style=\'position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:120px\' src=\'https://www.zeffy.com/embed/thermometer/a16d1ca9-d260-4d5c-91a3-4522cb70e976\'  allowTransparency="true"></iframe></div></div>\n\n\n\n<h2 class="wp-block-heading">Form</h2>\n\n\n\n<div style="border:1px solid black; padding:10px;"><div style="position:relative;overflow:hidden;height:1200px;width:100%;"><iframe title=\'Donation form powered by Zeffy\' style=\'position: absolute; border: 0; top:0;left:0;bottom:0;right:0;width:100%;height:100%\' src=\'https://www.zeffy.com/embed/donation-form/a16d1ca9-d260-4d5c-91a3-4522cb70e976\' allowpaymentrequest allowTransparency="true"></iframe></div></div>\n\n\n\n<p>Why not use them all?</p>\n',
  wordpressId: 7187,
}
